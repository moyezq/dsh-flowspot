{
  "name": "dsh-flowspot",
  "version": "0.6.12",
  "description": "Flowspot — Charles-style HTTPS capture for DeepSeek Harness (Windows): an in-plugin MITM proxy, system-proxy and CA automation, flow storage, and agent tools. Flowspot：面向 DeepSeek Harness 的 Charles 式抓包插件——插件内 MITM 代理 + Windows 系统代理/CA 自动配置 + 流量存储 + agent 工具。",
  "license": "MIT",
  "author": "moyezq",
  "homepage": "https://github.com/moyezq/dsh-flowspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyezq/dsh-flowspot.git"
  },
  "bugs": {
    "url": "https://github.com/moyezq/dsh-flowspot/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "locale",
    "extension",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "flowspot",
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mitm",
    "proxy",
    "capture",
    "https"
  ]
}
