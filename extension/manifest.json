{
  "manifest_version": 3,
  "name": "Flowspot Bridge",
  "version": "0.2.9",
  "description": "把当前标签页的 CDP 事件转给本机 dsh-flowspot（只连 127.0.0.1）。",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Flowspot：接管当前标签页"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
